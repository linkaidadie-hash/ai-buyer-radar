# ============================================================
# AI Buyer Radar V1 - Environment Configuration Example
# ============================================================
# Copy this file to .env and fill in real values.
# DO NOT commit .env to version control.

# ============================================================
# Database
# ============================================================
DATABASE_URL=sqlite:///./database/buyers.db

# ============================================================
# Security
# ============================================================
# Application secret key (JWT/HMAC, min 32 chars)
SECRET_KEY=change-me-in-production-min-32-chars-replace-this

# Data encryption key (Fernet, 44 chars base64)
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ============================================================
# Auth
# ============================================================
# Default admin credentials (change in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ============================================================
# AI Provider (reserved for future)
# ============================================================
# Currently using rule engine only. These are reserved for future LLM integration.
AI_PROVIDER=rule_engine
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# ============================================================
# Server
# ============================================================
HOST=0.0.0.0
PORT=8000
APP_ENV=production
